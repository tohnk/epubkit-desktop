{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "epubkit",
  "version": "0.1.0",
  "identifier": "com.epubkit.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "epubkit",
        "width": 760,
        "height": 900,
        "minWidth": 520,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
